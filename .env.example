# Bev works with zero config. With no keys set, she runs in mock mode
# (keyword heuristic, fake 200 to 450ms latency) and shows a "mock mode" badge in dev.
#
# To use real Jev, set ONE of these. If several are set, the first one present wins,
# in this order: TypeSafe direct, then Vercel AI Gateway, then OpenRouter.

# 1. TypeSafe direct (first party): POST https://api.typesafe.ai/v1/systemone
TYPESAFE_API_KEY=

# 2. Vercel AI Gateway: experimental_evaluate from `ai`, model "typesafe-ai/jev"
AI_GATEWAY_API_KEY=

# 3. OpenRouter (alpha decisions endpoint): POST https://openrouter.ai/api/alpha/decisions
OPENROUTER_API_KEY=

# Optional: force a backend regardless of which keys are set.
# One of: typesafe | gateway | openrouter | mock
# JEV_PROVIDER=

# Optional model overrides (defaults shown).
# JEV_MODEL=jev-latest
# JEV_GATEWAY_MODEL=typesafe-ai/jev
# JEV_OPENROUTER_MODEL=typesafe/jev-1.13

# Optional: absolute site URL used for metadata. On Vercel this is detected automatically.
# NEXT_PUBLIC_SITE_URL=https://your-bev.vercel.app
